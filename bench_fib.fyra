function $fibonacci(%n : w) : w {
@start
    %cmp = sle %n, 1 : w
    jnz %cmp, @base, @recur

@base
    ret %n : w

@recur
    %n1 = sub %n, 1 : w
    %r1 = call $fibonacci(%n1 : w) : w
    %n2 = sub %n, 2 : w
    %r2 = call $fibonacci(%n2 : w) : w
    %res = add %r1, %r2 : w
    ret %res : w
}

export function $main() : w {
@start
    %c = copy 40 : w
    %res = call $fibonacci(%c : w) : w
    ret %res : w
}
