function $add_many(%a : i32, %b : i32, %c : i32, %d : i32, %e : i32, %f : i32, %g : i32, %h : i32, %i : i32) : i32 {
@entry
    %t0 = add %a, %b : i32
    %t1 = add %t0, %c : i32
    %t2 = add %t1, %d : i32
    %t3 = add %t2, %e : i32
    %t4 = add %t3, %f : i32
    %t5 = add %t4, %g : i32
    %t6 = add %t5, %h : i32
    %t7 = add %t6, %i : i32
    ret %t7 : i32
}

export function $main() : i32 {
@entry
    %t0 = call $add_many(i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9) : i32
    ret %t0 : i32
}
