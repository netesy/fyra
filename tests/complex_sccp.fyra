export function $main() : i32 {
@start
    %n = copy 5 : i32
    %res = call $complex_sccp(%n) : i32
    ret %res : i32
}

function $complex_sccp(%n : i32) : i32 {
@start
    %cond = copy 1 : i32
    jnz %cond, @then, @else
@then
    ret 100 : i32
@else
    %val = add %n, 2 : i32
    ret %val : i32
}
