function $fibonacci(%n : i32) : i32 {
@start
    %t0 = cmp le %n, 1 : i32
    br %t0, @base_case, @recursive_case : i32

@base_case
    ret %n : i32

@recursive_case
    %t1 = sub %n, 1 : i32
    %t2 = call $fibonacci(%t1) : i32
    %t3 = sub %n, 2 : i32
    %t4 = call $fibonacci(%t3) : i32
    %t5 = add %t2, %t4 : i32
    ret %t5 : i32
}

export function $main() : i32 {
@start
    %t0 = call $fibonacci(i32 10) : i32
    ret %t0 : i32
}