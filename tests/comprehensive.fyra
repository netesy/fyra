# This file contains a comprehensive set of Fyra syntax features for testing the parser.

# Data section
data $my_string = { i8 "hello world", i8 0 }
data $my_array = { i32 1, i32 2, i32 3, i32 4 }

# Struct definition
type :my_struct = { i32, i64, f32, f64 }

# Union definition
type :my_union = { { i32, i64 }, { f32, f64 } }

# Function with various parameter types
function $test_params(%a : i32, %b : i64, %c : f32, %d : f64) : i32 {
@start
    ret 0 : i32
}

# Function with variadic arguments
function $variadic_func(...) : i32 {
@start
    %ap = alloc 16 : i64
    vastart %ap
    %arg1 = vaarg %ap : i32
    %arg2 = vaarg %ap : i64
    ret %arg1 : i32
}

# Main function with all kinds of instructions
export function $main() : i32 {
@start
    # Arithmetic
    %add = add 1, 2 : i32
    %sub = sub 10, 5 : i32
    %mul = mul 3, 4 : i32
    %div = div 100, 10 : i32
    %udiv = udiv 100, 10 : i32
    %rem = rem 10, 3 : i32
    %urem = urem 10, 3 : i32
    %neg = neg 5 : i32

    # Floating point arithmetic
    %fadd = fadd f32_1.0, f32_2.0 : f32
    %fsub = fsub f32_10.0, f32_5.0 : f32
    %fmul = fmul f64_3.0, f64_4.0 : f64
    %fdiv = fdiv f64_100.0, f64_10.0 : f64

    # Bitwise
    %and = and 0b1100, 0b1010 : i32
    %or = or 0b1100, 0b1010 : i32
    %xor = xor 0b1100, 0b1010 : i32
    %shl = shl 1, 2 : i32
    %shr = shr 8, 2 : i32
    %sar = sar -8, 2 : i32

    # Comparisons
    %eq = eq 1, 1 : i32
    %ne = ne 1, 2 : i32
    %slt = slt -1, 1 : i32
    %sle = sle 1, 1 : i32
    %sgt = sgt 2, 1 : i32
    %sge = sge 2, 2 : i32
    %ult = ult 1, 2 : i32
    %ule = ule 2, 2 : i32
    %ugt = ugt 2, 1 : i32
    %uge = uge 2, 2 : i32
    %lt = lt f32_1.0, f32_2.0 : f32
    %le = le f32_2.0, f32_2.0 : f32
    %gt = gt f64_2.0, f64_1.0 : f64
    %ge = ge f64_2.0, f64_2.0 : f64
    %co = co f32_1.0, f32_2.0 : f32
    %cuo = cuo f32_1.0, f32_2.0 : f32

    # Memory
    %p = alloc 16 : i64
    store 123, %p : i32
    %val = load %p : i32
    blit $my_string, %p, 12

    # Control flow
    jmp @end
@end
    %phi = phi @start %val, @start %add : i32
    hlt
    ret %val : i32
}
