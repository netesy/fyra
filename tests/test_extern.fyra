# Test extern capability system
extern io.write(i32, i64, i32) : i32
extern process.exit(i32)

export function $main() : i32 {
@entry
    # Test io.write
    %fd = copy 1 : i32
    %msg = copy $hello : i64
    %len = copy 13 : i32
    %res = extern io.write(%fd, %msg, %len) : i32

    # Test process.exit
    extern process.exit(0)
    ret 0 : i32
}

data $hello = { i8 "Hello, World\n", i8 0 }
