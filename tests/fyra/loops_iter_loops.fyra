}

function lm_assert(i32, i64) {
@entry
  br %0 %pass %fail
@fail
  %3 = extern io.write(i64 1, i8* %assert_fail, i64 17) : i64
  %4 = extern process.exit(i64 1) : i64
  ret null
@pass
  ret null
}
