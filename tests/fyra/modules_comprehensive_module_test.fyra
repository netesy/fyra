function lm_print_int(i64) {
@entry
  %1 = alloc 32 : i64
  %2 = add %1 31 : i64
  storeb 10 %2
  %4 = alloc 8 : i64
  %5 = alloc 8 : i64
  store %2 %5
  %7 = cslt %0 0 : i32
