function lm_print_str(i8*) {
@entry
  %1 = alloc 8 : i64
  store 0 %1
  jmp %loop
@loop
  %4 = load %1 : i32
  %5 = add %0 %4 : i8*
  %6 = loadub %5 : i32
  %7 = ceq %6 0 : i32
  %8 = add %4 1 : i32
  store %8 %1
  br %7 %done %loop
@done
  %11 = load %1 : i32
  %12 = sub %11 1 : i32
  %13 = extern io.write(i64 1, i8* %0, i32 %12) : i64
  %14 = extern io.write(i64 1, i8* %nl, i64 1) : i64
  ret null
}
