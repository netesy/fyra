function lm_print_int(i64) {
@entry
  %1 = alloc 32 : i64
  %2 = add %1 31 : i64
  storeb 10 %2
  %4 = alloc 8 : i64
  %5 = alloc 8 : i64
  store %2 %5
  %7 = cslt %0 0 : i32
  br %7 %neg %abs
@neg
  %9 = extern io.write(i64 1, i8* %str_minus, i64 1) : i64
  %10 = neg %0 : i64
  store %10 %4
  jmp %loop
@abs
  store %0 %4
  jmp %loop
@loop
