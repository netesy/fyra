# Fyra Benchmark Suite

# 1. Arithmetic (32-bit integer)
# (100 + 50 - 20) * 2 / 10 = 13
function $test_arith_w() : i32 {
@start
    %t1 = add 100, 50 : i32
    %t2 = sub %t1, 20 : i32
    %t3 = mul %t2, 2 : i32
    %res = div %t3, 10 : i32
    ret %res : i32
}

# 2. Arithmetic (32-bit float)
# (10.0 + 5.0 - 2.0) * 2.0 / 4.0 = 6.5 -> cast to w = 6
function $test_arith_float() : i32 {
@start
    %f1 = fadd f32_10.0, f32_5.0 : f32
    %f2 = fsub %f1, f32_2.0 : f32
    %f3 = fmul %f2, f32_2.0 : f32
    %f4 = fdiv %f3, f32_4.0 : f32
    %res = stosi %f4 : i32
    ret %res : i32
}

# 3. Bitwise (64-bit integer)
# (0xA0A0 & 0xF0F0) | 0x0101 ^ 0x00FF
# 0xA0A0 & 0xF0F0 = 0xA0A0
# 0xA0A0 | 0x0101 = 0xA1A1
# 0xA1A1 ^ 0x00FF = 0xA15E (41310)
function $test_bitwise() : i64 {
@start
    %t1 = and 41120, 61680 : i64
    %t2 = or %t1, 257 : i64
    %res = xor %t2, 255 : i64
    ret %res : i64
}

# 4. Comparison (32-bit integer)
# (10 == 10) + (10 != 5) + (5 < 10) + (10 > 5) = 4
function $test_comp_w() : i32 {
@start
    %c1 = eq 10, 10 : i32
    %c2 = ne 10, 5 : i32
    %c3 = slt 5, 10 : i32
    %c4 = sgt 10, 5 : i32
    %s1 = add %c1, %c2 : i32
    %s2 = add %s1, %c3 : i32
    %res = add %s2, %c4 : i32
    ret %res : i32
}

# 5. Memory Loads/Stores
function $test_mem() : i32 {
@start
    %p = alloc 4 : i64
    store 42, %p : i32
    %res = load %p : i32
    ret %res : i32
}

# 6. Cast Torture
# converts w to d and back to l to check sign-extension and precision
# Using a negative number to test sign-extension
function $cast_torture() : i64 {
@start
    %w = copy -12345678 : i32
    %d = swtof %w : f64
    %w2 = dtosi %d : i32
    %res = extsw %w2 : i64
    ret %res : i64
}

# 7. Type Casting
# extsb -1 : i32 -> -1
# extsh 0x7FFF : i32 -> 32767
# sum = -1 + 32767 = 32766
function $test_conv() : i32 {
@start
    %b = extsb 255 : i32
    %h = extsh 32767 : i32
    %res = add %b, %h : i32
    ret %res : i32
}

# 8. The Phi-Maze
# Diamond inside While
# while (i < 10) { if (i % 2 == 0) x += 1 else x += 2; i++ }
# returns 15
function $phi_maze() : i32 {
@entry
    jmp @loop
@loop
    %i = phi @entry 0, @merge %i_next : i32
    %x = phi @entry 0, @merge %x_next : i32
    %cond = slt %i, 10 : i32
    jnz %cond, @diamond, @exit
@diamond
    %rem = rem %i, 2 : i32
    %is_even = eq %rem, 0 : i32
    jnz %is_even, @then, @else
@then
    %x_then = add %x, 1 : i32
    jmp @merge
@else
    %x_else = add %x, 2 : i32
    jmp @merge
@merge
    %x_next = phi @then %x_then, @else %x_else : i32
    %i_next = add %i, 1 : i32
    jmp @loop
@exit
    ret %x : i32
}

# 9. The Infinite-ish Loop
# sum of (i << 1) for i from 0 to 999
# sum = 2 * (999 * 1000 / 2) = 999000
function $loop_1000() : i64 {
@entry
    jmp @loop
@loop
    %i = phi @entry 0, @body %i_next : i64
    %sum = phi @entry 0, @body %sum_next : i64
    %cond = slt %i, 1000 : i64
    jnz %cond, @body, @exit
@body
    %val = shl %i, 1 : i64
    %sum_next = add %sum, %val : i64
    %i_next = add %i, 1 : i64
    jmp @loop
@exit
    ret %sum : i64
}

# 10. Floating point comparisons
# (1.0 < 2.0) + (2.0 <= 2.0) + (3.0 > 2.0) + (2.0 >= 2.0) + (1.0 co 2.0) = 5
function $test_fp_comp() : i32 {
@start
    %c1 = lt f32_1.0, f32_2.0 : f32
    %c2 = le f32_2.0, f32_2.0 : f32
    %c3 = gt f32_3.0, f32_2.0 : f32
    %c4 = ge f32_2.0, f32_2.0 : f32
    %c5 = co f32_1.0, f32_2.0 : f32
    %s1 = add %c1, %c2 : i32
    %s2 = add %s1, %c3 : i32
    %s3 = add %s2, %c4 : i32
    %res = add %s3, %c5 : i32
    ret %res : i32
}
