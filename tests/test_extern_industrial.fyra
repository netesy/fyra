# Test industrial-level extern capability system
extern io.write(i32, i64, i32) : i32
extern io.read(i32, i64, i32) : i32
extern memory.alloc(i64) : i64
extern memory.free(i64, i64)
extern random.u64() : i64
extern time.now() : i64
extern process.exit(i32)

export function $main() : i32 {
@entry
    # Test memory.alloc
    %size = copy 1024 : i64
    %ptr = extern memory.alloc(%size) : i64

    # Test random.u64
    %rand = extern random.u64() : i64

    # Test time.now
    %now = extern time.now() : i64

    # Test io.write
    %fd = copy 1 : i32
    %msg = copy $msg : i64
    %len = copy 14 : i32
    %res_write = extern io.write(%fd, %msg, %len) : i32

    # Test memory.free
    extern memory.free(%ptr, %size)

    # Test process.exit
    extern process.exit(0)
    ret 0 : i32
}

data $msg = { i8 "Testing Extern\n", i8 0 }
