export function $main() : i32 {
@start
    %i = copy 0 : i32
    jmp @loop
@loop
    %i2 = phi [@start, %i], [@body, %i3]
    %cond = cslt %i2, 10 : i32
    jnz %cond, @body, @end
@body
    %i3 = add %i2, 1 : i32
    %res_call = call $external_func(%i3) : i32
    jmp @loop
@end
    ret %i2 : i32
}

function $external_func(%n : i32) : i32 {
@start
    ret %n : i32
}
