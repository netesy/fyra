# Industrial-grade capability test suite
extern io.open(i64, i32, i32) : i64
extern io.write(i64, i64, i64) : i64
extern io.read(i64, i64, i64) : i64
extern io.seek(i64, i64, i32) : i64
extern io.stat(i64, i64) : i32
extern io.close(i64)

extern memory.alloc(i64) : i64
extern memory.free(i64, i64)
extern memory.protect(i64, i64, i32) : i32

extern process.exit(i32)
extern process.abort()
extern process.sleep(i64)

extern random.u64() : i64
extern time.now() : i64
extern time.monotonic() : i64

extern sync.mutex.lock(i64)
extern sync.mutex.unlock(i64)

extern debug.log(i64)

export function $main() : i32 {
@entry
    # Test IO
    %path = copy $path_str : i64
    %fd = extern io.open(%path, 0, 0) : i64
    %buf = extern memory.alloc(1024) : i64
    %nread = extern io.read(%fd, %buf, 1024) : i64
    %nwrite = extern io.write(%fd, %buf, 1024) : i64
    %nseek = extern io.seek(%fd, 0, 0) : i64
    extern io.close(%fd)

    # Test Memory
    extern memory.protect(%buf, 1024, 1) : i32
    extern memory.free(%buf, 1024)

    # Test Time & Random
    %t1 = extern time.now() : i64
    %t2 = extern time.monotonic() : i64
    %r = extern random.u64() : i64

    # Test Sync
    %mutex = extern memory.alloc(8) : i64
    extern sync.mutex.lock(%mutex)
    extern sync.mutex.unlock(%mutex)

    # Test Debug
    extern debug.log($path_str)

    extern process.exit(0)
    ret 0 : i32
}

data $path_str = { i8 "test.txt", i8 0 }
