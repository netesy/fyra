  %h1 = add %h0,19:i64
  %h2 = xor %h1,23:i64
  %h3 = add %h2,29:i64
  %h4 = xor %h3,31:i64
  %h5 = add %h4,37:i64
  %h6 = xor %h5,41:i64
  %h7 = add %h6,43:i64
  %h8 = xor %h7,47:i64
  %h9 = add %h8,53:i64
  %h10 = xor %h9,59:i64
  %h11 = add %h10,61:i64
