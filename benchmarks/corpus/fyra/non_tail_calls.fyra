function $helper2(%x:i16):i64 {
@entry
  %w = extsh %x:i64
  %a = add %w,11:i64
  ret %a:i64
}
function $helper(%x:i16,%y:i64):i64 {
@entry
  %a = call $helper2(%x):i64
  %b = add %a,%y:i64
  %c = mul %b,3:i64
  %d = xor %c,%y:i64
  %e = add %d,7:i64
  %f = mul %e,5:i64
  %g = sub %f,%a:i64
