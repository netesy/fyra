  %h18 = xor %h17,97:i64
  %h19 = add %h18,101:i64
  ret %h19:i64
}
export function $main(%argc:i32):i32 {
@entry
  %arg16 = truncd %argc:i16
  %arg64 = extsw %argc:i64
  %y0 = add %arg64,99:i64
  %y1 = add %arg64,199:i64
  %x1 = add %arg16,4:i16
  %a = call $helper(%arg16,%y0):i64
  %b = call $helper(%x1,%y1):i64
  %sum = add %a,%b:i64
  %out = add %sum,1:i64
  call $print_checksum(i64 %out)
  ret 0:i32
}
