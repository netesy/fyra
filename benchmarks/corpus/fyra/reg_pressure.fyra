function $test_reg_pressure_16(%a0 : i32, %a1 : i32, %a2 : i32, %a3 : i32, %a4 : i32, %a5 : i32, %a6 : i32, %a7 : i32) : i32 {
@start
    %v0 = add %a0, %a1 : i32
    %v1 = add %a2, %a3 : i32
    %v2 = add %a4, %a5 : i32
    %v3 = add %a6, %a7 : i32
    %v4 = mul %v0, %v1 : i32
    %v5 = mul %v2, %v3 : i32
    %v6 = add %v0, %v2 : i32
    %v7 = add %v1, %v3 : i32
    %s1 = add %v4, %v5 : i32
    %s2 = sub %v6, %v7 : i32
    %res = mul %s1, %s2 : i32
    ret %res : i32
}

export function $main() : i32 {
@entry
    jmp @loop

@loop
    %i = phi @entry 1, @body %i_next : i32
    %sum = phi @entry 0, @body %sum_next : i64
    %cond = sle %i, 50000000 : i32
    jnz %cond, @body, @exit

@body
    %i1 = add %i, 1 : i32
    %i2 = add %i, 2 : i32
    %i3 = add %i, 3 : i32
    %i4 = add %i, 4 : i32
    %i5 = add %i, 5 : i32
    %i6 = add %i, 6 : i32
    %i7 = add %i, 7 : i32
    %v = call $test_reg_pressure_16(%i, %i1, %i2, %i3, %i4, %i5, %i6, %i7) : i32
    %v_ext = extsw %v : i64
    %sum_next = add %sum, %v_ext : i64
    %i_next = add %i, 1 : i32
    jmp @loop

@exit
    call $print_checksum(i64 %sum)
    ret 0 : i32
}
