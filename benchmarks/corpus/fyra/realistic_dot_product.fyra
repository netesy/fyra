function $dot_product(%n : i32) : i64 {
@entry
    jmp @loop

@loop
    %i = phi @entry i32 0, @body %i_next : i32
    %sum = phi @entry i64 0, @body %sum_next : i64
    %cond = slt %i, %n : i32
    jnz %cond, @body, @exit

@body
    %t3 = mul %i, i32 3 : i32
    %a_w = add %t3, i32 1 : i32
    %a = extsw %a_w : i64

    %t7 = mul %i, i32 7 : i32
    %b_w = add %t7, i32 2 : i32
    %b = extsw %b_w : i64

    %prod = mul %a, %b : i64
    %sum_next = add %sum, %prod : i64
    %i_next = add %i, i32 1 : i32
    jmp @loop

@exit
    ret %sum : i64
}

export function $main() : i32 {
@entry
    jmp @loop

@loop
    %k = phi @entry i32 0, @body %k_next : i32
    %res = phi @entry i64 0, @body %res_next : i64
    %cond = slt %k, i32 20 : i32
    jnz %cond, @body, @exit

@body
    %v = call $dot_product(i32 5000000) : i64
    %res_next = add %res, %v : i64
    %k_next = add %k, i32 1 : i32
    jmp @loop

@exit
    call $print_checksum(i64 %res)
    ret i32 0 : i32
}
