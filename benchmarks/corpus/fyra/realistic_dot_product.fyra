function $dot_product(%n : w) : l {
@entry
    jmp @loop

@loop
    %i = phi @entry 0, @body %i_next : w
    %sum = phi @entry 0, @body %sum_next : l
    %cond = slt %i, %n : w
    jnz %cond, @body, @exit

@body
    %i_l = extsw %i : l
    %t3 = mul %i_l, 3 : l
    %a = add %t3, 1 : l
    %t7 = mul %i_l, 7 : l
    %b = add %t7, 2 : l
    %prod = mul %a, %b : l
    %sum_next = add %sum, %prod : l
    %i_next = add %i, 1 : w
    jmp @loop

@exit
    ret %sum : l
}

export function $main() : w {
@entry
    jmp @loop

@loop
    %k = phi @entry 0, @body %k_next : w
    %res = phi @entry 0, @body %res_next : l
    %cond = slt %k, 20 : w
    jnz %cond, @body, @exit

@body
    %v = call $dot_product(w 5000000) : l
    %res_next = add %res, %v : l
    %k_next = add %k, 1 : w
    jmp @loop

@exit
    call $print_checksum(l %res)
    ret 0 : w
}
