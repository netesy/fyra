function $tail_factorial(%n : i64, %acc : i64) : i64 {
@start
    %cond = sle %n, 1 : i64
    jnz %cond, @base, @recur

@base
    ret %acc : i64

@recur
    %n_next = sub %n, 1 : i64
    %acc_next = mul %acc, %n : i64
    %res = call $tail_factorial(%n_next, %acc_next) : i64
    ret %res : i64
}

export function $main() : i32 {
@entry
    jmp @loop

@loop
    %i = phi @entry 0, @body %i_next : i32
    %sum = phi @entry 0, @body %sum_next : i64
    %cond = slt %i, 5000000 : i32
    jnz %cond, @body, @exit

@body
    %v = call $tail_factorial(i64 15, i64 1) : i64
    %sum_next = add %sum, %v : i64
    %i_next = add %i, 1 : i32
    jmp @loop

@exit
    call $print_checksum(i64 %sum)
    ret 0 : i32
}
