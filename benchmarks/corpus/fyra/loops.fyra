function $test_loop_sum(%n : w) : l {
@entry
    jmp @loop

@loop
    %i = phi @entry 0, @body %i_next : w
    %sum = phi @entry 0, @body %sum_next : l
    %cond = slt %i, %n : w
    jnz %cond, @body, @exit

@body
    %term = mul %i, 2 : w
    %term_l = extsw %term : l
    %sum_next = add %sum, %term_l : l
    %i_next = add %i, 1 : w
    jmp @loop

@exit
    ret %sum : l
}

export function $main() : w {
@entry
    jmp @loop

@loop
    %k = phi @entry 1, @body %k_next : w
    %total = phi @entry 0, @body %total_next : l
    %cond = sle %k, 50 : w
    jnz %cond, @body, @exit

@body
    %v = call $test_loop_sum(w 2000000) : l
    %total_next = add %total, %v : l
    %k_next = add %k, 1 : w
    jmp @loop

@exit
    call $print_checksum(l %total)
    ret 0 : w
}
