export function $main() : w {
@entry
    %r = call $fibonacci(42 : w) : w
    ret %r : w
}

function $fibonacci(%n : w) : w {
@entry
    %cmp = sle %n, 1 : w
    jnz %cmp, @base, @recur
@base
    ret %n : w
@recur
    %n1 = sub %n, 1 : w
    %r1 = call $fibonacci(%n1 : w) : w
    %n2 = sub %n, 2 : w
    %r2 = call $fibonacci(%n2 : w) : w
    %res = add %r1, %r2 : w
    ret %res : w
}
